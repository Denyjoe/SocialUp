# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to fall back to a local SQLite file (quick start, no DB server needed).
# When running via docker-compose this is set to the postgres service automatically.
DATABASE_URL=postgres://smm:smm@localhost:5432/smm

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Phase 3: VinaSMM (upstream provider) ---
# Get your key from your VinaSMM account, then run:
#   python manage.py setup_vinasmm_provider
# PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://vinasmm.com/api/v2

# --- Phase 4: AzamPay sandbox credentials (fill in once issued) ---
# AZAMPAY_APP_NAME=
# AZAMPAY_CLIENT_ID=
# AZAMPAY_CLIENT_SECRET=
# AZAMPAY_SANDBOX=True

# --- Phase 7: registration hardening ---
FRONTEND_BASE_URL=http://localhost:5173
# This backend's own public URL — used to build the NOWPayments IPN callback
# URL below. Only matters once you're testing against a real, publicly
# reachable deployment (NOWPayments cannot call back to localhost).
BACKEND_BASE_URL=http://localhost:8000

# Google Sign-In — see docs/google-signin-setup.md
GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Beem Africa OTP — see docs/beem-otp-assumptions.md
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_APP_ID=

# Cloudflare Turnstile — see docs/turnstile-setup.md. Leave TURNSTILE_ENABLED
# unset/False for local dev with no Cloudflare account.
# TURNSTILE_ENABLED=True
# TURNSTILE_SECRET_KEY=

# Transactional email (any SMTP provider — Brevo recommended) — see
# docs/transactional-email-setup.md. Not needed locally (console backend).
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- Crypto deposits via NOWPayments (interim, while PesaPal verification is
# pending) — see docs/nowpayments-crypto-setup.md. Leave both unset for local
# dev/tests: deposits fall back to a mock gateway that completes instantly.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Only needed if you want to override the auto-built default
# (BACKEND_BASE_URL + /api/payments/webhooks/nowpayments/).
# NOWPAYMENTS_IPN_CALLBACK_URL=
